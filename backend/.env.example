# Local dev database (matches docker-compose.yml at repo root)
DATABASE_URL="postgresql://sheba:sheba_dev_password@localhost:5432/sheba_dev"

PORT=4000
NODE_ENV=development

# Frontend origin allowed to call this API with credentials
CORS_ORIGIN="http://localhost:5173"

# Generate real random secrets for these, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET="dev_access_secret_change_me"
JWT_REFRESH_SECRET="dev_refresh_secret_change_me"

ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
